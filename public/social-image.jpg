<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2563eb;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1d4ed8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1e3a8a;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg-grad)"/>
  
  <!-- Pattern overlay -->
  <g opacity="0.1">
    <circle cx="100" cy="100" r="2" fill="white"/>
    <circle cx="140" cy="100" r="2" fill="white"/>
    <circle cx="180" cy="100" r="2" fill="white"/>
    <circle cx="220" cy="100" r="2" fill="white"/>
    <circle cx="260" cy="100" r="2" fill="white"/>
    <circle cx="300" cy="100" r="2" fill="white"/>
    <circle cx="100" cy="140" r="2" fill="white"/>
    <circle cx="140" cy="140" r="2" fill="white"/>
    <circle cx="180" cy="140" r="2" fill="white"/>
    <circle cx="220" cy="140" r="2" fill="white"/>
    <circle cx="260" cy="140" r="2" fill="white"/>
    <circle cx="300" cy="140" r="2" fill="white"/>
  </g>
  
  <!-- Logo/Icon -->
  <circle cx="600" cy="200" r="60" fill="white" opacity="0.9"/>
  <path d="M 560 220 Q 600 180 640 220" stroke="#2563eb" stroke-width="8" fill="none" stroke-linecap="round"/>
  <circle cx="575" cy="195" r="6" fill="#2563eb"/>
  <circle cx="625" cy="195" r="6" fill="#2563eb"/>
  
  <!-- Text -->
  <text x="600" y="340" font-family="Arial, sans-serif" font-size="72" font-weight="bold" fill="white" text-anchor="middle">
    Cotyledon Lab
  </text>
  <text x="600" y="400" font-family="Arial, sans-serif" font-size="32" fill="#93c5fd" text-anchor="middle">
    Innovative Business Solutions
  </text>
</svg>
