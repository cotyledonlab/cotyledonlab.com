---
type ShowcaseItem = {
  title: string;
  summary: string;
  stack: string;
  link: string;
  badge: string;
};

const showcase: ShowcaseItem[] = [
  {
    title: 'VoxShop',
    summary: 'Voice-first shopping list app. Add items hands-free while cooking or on the go.',
    stack: 'React · Vite · Web Speech API',
    link: '/demos/voxshop',
    badge: 'Live Demo',
  },
  {
    title: 'Meal Planner Copilot',
    summary: 'AI-assisted nutrition planning tool that generates menus, groceries, and macros in seconds.',
    stack: 'Next.js · OpenAI · Supabase',
    link: '/demos/meal-planner',
    badge: 'Live Demo',
  },
  {
    title: 'Seq',
    summary: 'Browser-based step sequencer and drum machine. Make beats right in your browser.',
    stack: 'React · Tone.js · Web Audio',
    link: '/demos/seq',
    badge: 'Live Demo',
  },
  {
    title: 'HTTP Request Studio',
    summary: 'Neumorphic API testing studio with collections, history, and environment variables.',
    stack: 'SvelteKit · Svelte 5 · Tauri',
    link: '/demos/http-request-studio',
    badge: 'Live Demo',
  },
];
---

<section id="showcase" class="bg-slate-950 py-24 text-white">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="flex flex-col gap-6 text-center lg:flex-row lg:items-end lg:justify-between lg:text-left">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.4em] text-white/50">Showcase</p>
        <h2 class="mt-4 text-4xl font-semibold sm:text-5xl">Working demos from the lab</h2>
        <p class="mt-4 max-w-2xl text-lg text-white/70">
          Side projects and experiments I'm building in public. Try them out and let me know what you think.
        </p>
      </div>
      <a
        href="#contact"
        class="inline-flex items-center justify-center rounded-2xl border border-white/20 px-5 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-white/80 transition hover:border-white hover:text-white"
      >
        Have a project idea? Let's chat
      </a>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {showcase.map((item) => (
        <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-white/5 to-white/[0.02] p-6 backdrop-blur transition hover:-translate-y-1">
          <div class="flex items-center gap-3">
            <span class="rounded-full border border-white/30 px-3 py-1 text-xs font-semibold uppercase tracking-[0.4em] text-white/70">
              {item.badge}
            </span>
            <div class="h-px flex-1 bg-white/10"></div>
          </div>
          <h3 class="mt-6 text-2xl font-semibold">{item.title}</h3>
          <p class="mt-3 text-base text-white/75">{item.summary}</p>
          <p class="mt-6 text-sm uppercase tracking-[0.4em] text-white/50">{item.stack}</p>
          <a
            href={item.link}
            class="mt-8 inline-flex items-center justify-between rounded-2xl border border-white/20 px-4 py-3 text-sm font-semibold text-white transition group-hover:border-white/50"
          >
            Preview the demo
            <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
