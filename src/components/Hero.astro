---
import { SITE_CONFIG } from '../config';
---

<section class="relative overflow-hidden bg-slate-950 text-white">
  <div class="absolute inset-0">
    <div class="absolute inset-y-0 left-1/2 h-[800px] w-[800px] -translate-x-1/2 rounded-full bg-blue-500/30 blur-[180px]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(14,165,233,0.25),_transparent_55%)]"></div>
  </div>
  <div class="relative mx-auto flex max-w-7xl flex-col gap-16 px-6 py-24 sm:px-8 lg:flex-row lg:items-center lg:py-32">
    <div class="max-w-3xl space-y-8 text-center lg:text-left">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-1 text-sm uppercase tracking-[0.2em] text-white/70">
        Product Studio · App Development
      </span>
      <h1 class="text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">
        We design, build, and launch flagship products for ambitious teams.
      </h1>
      <p class="text-lg text-white/80 md:text-xl">
        {SITE_CONFIG.title} is an app development company crafting bespoke web and mobile experiences. We pair strategy, design, and full-stack engineering to ship polished software fast.
      </p>
      <div class="flex flex-col items-center gap-4 sm:flex-row lg:justify-start">
        <a
          href="#contact"
          class="inline-flex min-w-[180px] items-center justify-center rounded-2xl bg-white px-8 py-3 text-base font-semibold text-slate-950 shadow-xl shadow-blue-500/30 transition hover:-translate-y-0.5 hover:bg-slate-100"
        >
          Book a Build Sprint
        </a>
        <a
          href="#showcase"
          class="inline-flex items-center gap-2 text-base font-semibold text-white/80 transition hover:text-white"
        >
          View demo showcase
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <dl class="grid grid-cols-2 gap-6 border-t border-white/10 pt-6 text-left sm:grid-cols-3">
        <div>
          <dt class="text-sm uppercase tracking-[0.25em] text-white/50">Products launched</dt>
          <dd class="text-3xl font-semibold text-white">35+</dd>
        </div>
        <div>
          <dt class="text-sm uppercase tracking-[0.25em] text-white/50">Average timelines</dt>
          <dd class="text-3xl font-semibold text-white">6 wks</dd>
        </div>
        <div>
          <dt class="text-sm uppercase tracking-[0.25em] text-white/50">Industries</dt>
          <dd class="text-3xl font-semibold text-white">Fintech · Health · AI</dd>
        </div>
      </dl>
    </div>
    <div class="w-full max-w-xl rounded-[32px] border border-white/10 bg-white/5 p-8 backdrop-blur">
      <div class="space-y-6">
        <p class="text-sm uppercase tracking-[0.4em] text-white/60">Inside the lab</p>
        <div class="rounded-3xl bg-white/90 p-6 text-slate-900 shadow-2xl ring-1 ring-black/5">
          <p class="text-xs uppercase tracking-[0.5em] text-slate-500">Current experiments</p>
          <ul class="mt-4 space-y-4 text-base text-slate-700">
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-blue-500"></span>
              AI-powered meal planning companion for nutrition teams.
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-emerald-500"></span>
              Investor reporting dashboard for a multi-family office.
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-purple-500"></span>
              Field technician app syncing offline diagnostics.
            </li>
          </ul>
          <a
            href="/demos/meal-planner"
            class="mt-6 inline-flex items-center justify-between rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-900 transition hover:bg-slate-50"
          >
            Try the meal planner demo
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="rounded-3xl border border-white/20 p-4 text-sm text-white/80">
          Full-stack team spanning product strategy, UX, frontend, backend, and cloud. Plug us in as your launch partner or an extension of your engineering org.
        </div>
      </div>
    </div>
  </div>
</section>
