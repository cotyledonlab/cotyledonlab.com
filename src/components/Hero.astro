---
import { SITE_CONFIG } from '../config';
---

<section class="relative bg-gradient-to-br from-blue-600 via-blue-700 to-blue-900 text-white">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        <span class="block">Welcome to</span>
        <span class="block text-blue-200">{SITE_CONFIG.title}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-blue-100">
        {SITE_CONFIG.description}
      </p>
      <div class="mt-10 flex justify-center gap-4">
        <a
          href="#contact"
          class="rounded-lg bg-white px-8 py-3 text-base font-semibold text-blue-700 shadow-lg transition hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-700"
        >
          Get Started
        </a>
        <a
          href="#features"
          class="rounded-lg border-2 border-white px-8 py-3 text-base font-semibold text-white transition hover:bg-white hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-700"
        >
          Learn More
        </a>
        <a
          href="/demos/meal-planner"
          class="rounded-lg bg-blue-500/20 px-8 py-3 text-base font-semibold text-white shadow-inner transition hover:bg-blue-500/30 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-700"
        >
          View Meal Planner Demo
        </a>
      </div>
    </div>
  </div>
  <div class="absolute inset-0 overflow-hidden opacity-10">
    <svg class="absolute h-full w-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <circle cx="20" cy="20" r="1" fill="currentColor" />
        </pattern>
      </defs>
      <rect x="0" y="0" width="100%" height="100%" fill="url(#hero-pattern)" />
    </svg>
  </div>
</section>
